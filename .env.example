# Canonical origin for metadata, JSON-LD, and the sitemap. Set it in Vercel
# production. When unset, production falls back to https://caytrongnha.com and
# previews use VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://caytrongnha.com

# Keep search engines out until the site is ready. Set false in production.
NEXT_PUBLIC_NO_INDEX=true

# Supabase content backend (required at build time and for ISR revalidation).
# Project Settings → API Keys. The publishable key is safe to expose: RLS only
# allows reading published content.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudinary image hosting (required at build time). Only images under
# res.cloudinary.com/<cloud-name>/image/upload/ are allowed by next/image.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ---------------------------------------------------------------------------
# SERVER ONLY — set these in .env.local and in the deployment (Vercel), but
# never prefix them with NEXT_PUBLIC_: they must not reach the browser.
# ---------------------------------------------------------------------------

# Supabase secret key (Project Settings → API Keys). Bypasses RLS; used by
# checkout, review submission, /api/reviews/revalidate and the RAG indexer
# (`npm run rag:index`, /api/rag/sync).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Plant chatbot. OpenAI is used only for embeddings (text-embedding-3-small);
# DeepSeek writes the answers. Without DEEPSEEK_API_KEY /api/chat returns 503.
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
# Optional, defaults to deepseek-v4-flash.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Shared secret for the Supabase Database Webhook that calls /api/rag/sync
# (header `Authorization: Bearer <value>`). Generate with `openssl rand -hex 32`.
# Sync is disabled while unset.
RAG_SYNC_SECRET=

# Shared secret for the Supabase Database Webhook that calls
# /api/reviews/revalidate (header `Authorization: Bearer <value>`), so a review
# shows up as soon as it is approved. Create the webhook in Database → Webhooks
# on table post_reviews, events UPDATE and DELETE, method POST. Generate with
# `openssl rand -hex 32`. While unset, approved reviews appear on the next
# hourly revalidation.
REVIEWS_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# LOCAL ONLY — never set these in Vercel or any deployed environment, and
# never prefix them with NEXT_PUBLIC_. The app itself does not read them.
# ---------------------------------------------------------------------------

# Used only by the Supabase CLI (`npm run db:push`, `npm run db:types`).
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=
